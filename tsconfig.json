{
  "compilerOptions": {
    "jsx": "react-native",
    "allowJs": true,
    "isolatedModules": true,
    "moduleResolution": "nodenext", // valid for customConditions
    "target": "ES6",
    "module": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native"
    ]
    // If you need "customConditions", add it here, otherwise ensure it's not present
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
