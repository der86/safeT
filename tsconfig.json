{
  "compilerOptions": {
    "jsx": "react-native",
    "allowJs": true,
    "isolatedModules": true,
    "moduleResolution": "nodenext",
    "target": "ES6",
    "module": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "dependencies": {
    "expo": "^48.0.0"
  },
  "extends": "expo/tsconfig.base"
}
